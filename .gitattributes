# Ensure shell scripts always use LF (prevent macOS/Linux execution errors)
*mvnw text eol=lf
*.sh text eol=lf

# Windows batch files
*.cmd text eol=crlf
*.bat text eol=crlf

# Source files normalized to LF
*.java text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sql text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf

# Binary files
*.jar binary
*.pdf binary
*.png binary
*.jpg binary
*.ico binary